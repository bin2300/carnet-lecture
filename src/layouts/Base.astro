---
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import site from '../data/site.json';
import { ui, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Chemin sans langue, ex. "" (accueil) ou "livres/la-taupe/" */
  path?: string;
}
const { lang, title, description, path = '' } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const pageTitle = title ? `${title} — ${site.siteName}` : site.siteName;
const desc = description ?? t.tagline;
const canonical = new URL(`/${lang}/${path}`, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(`/${other}/${path}`, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${site.siteName} (${lang})`} href={`/${lang}/rss.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`}>{site.siteName}</a>
        <nav>
          <a href={`/${lang}/#bibliotheque`}>{t.library}</a>
          <a href={`/${lang}/rss.xml`}>RSS</a>
          <a href={`/${other}/${path}`} hreflang={other} lang={other}>{ui[lang].switchTo}</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <span>{t.footer}</span>
        <a href={`/${lang}/rss.xml`}>{t.rss}</a>
      </div>
    </footer>
  </body>
</html>
